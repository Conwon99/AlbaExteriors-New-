---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { ContactFormSection } from '@/sections/ContactFormSection';
---

<BaseLayout 
  title="Exterior Cleaning Glasgow & Surrounding Areas | Alba Exteriors"
  description="Exterior cleaning across Glasgow and every suburb and town within 20km: Bearsden, Milngavie, Clydebank, Paisley, Renfrew, Bishopbriggs, Giffnock, Dumbarton and more. Free quotes."
  breadcrumbs={[
    { name: "Home", url: "/" },
    { name: "Locations", url: "/locations" }
  ]}
>
  <div
    role="main"
    class="text-sm bg-white box-border caret-transparent leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]"
  >
    <!-- Hero Section -->
    <div class="relative text-sm box-border caret-transparent flex items-center justify-center leading-[20.3px] break-words h-[400px] md:text-[17px] md:h-[500px] md:leading-[24.65px] overflow-hidden">
      <div
        class="absolute inset-0 bg-no-repeat bg-cover bg-center"
        style={`background-image: url('${encodeURI("/services/pressurewashing.png")}');`}
      />
      <div class="absolute inset-0 bg-black/50" />
      <div class="relative text-sm box-border caret-transparent z-10 leading-[20.3px] break-words text-center md:text-[17px] md:leading-[24.65px]">
        <h1 class="text-white text-4xl font-bold box-border caret-transparent leading-[50px] break-words uppercase font-thiccboi md:text-6xl md:leading-[70px] drop-shadow-lg">
          Glasgow Service Areas
        </h1>
        <p class="text-white text-xl box-border caret-transparent leading-[28px] break-words mt-4 md:text-2xl md:leading-[32px] drop-shadow-lg">
          Exterior Cleaning Throughout Glasgow & Surrounding Areas
        </p>
      </div>
    </div>

    <!-- Locations Content Section -->
    <div class="relative text-sm items-center box-border caret-transparent flex justify-center leading-[20.3px] break-words px-5 py-10 md:text-[17px] md:leading-[24.65px] md:px-5 md:py-16">
      <div class="text-sm box-border caret-transparent grow leading-[20.3px] max-w-[1300px] break-words mx-auto md:text-[17px] md:leading-[24.65px]">
        <!-- Introduction -->
        <div class="text-sm box-border caret-transparent text-center mb-12 leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]">
          <h2 class="text-neutral-900 text-3xl font-bold box-border caret-transparent leading-[42px] break-words uppercase font-thiccboi mb-4 md:text-4xl md:leading-[50px]">
            Where We Serve
          </h2>
          <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words max-w-3xl mx-auto font-figtree md:text-lg md:leading-7">
            Alba Exteriors is based in Glasgow G13 and serves homeowners and businesses across every Glasgow neighbourhood and all the surrounding suburbs and towns within 20km. That covers East and West Dunbartonshire, Renfrewshire, East Renfrewshire, and parts of Lanarkshire.
          </p>
        </div>

        <!-- Main Service Areas -->
        <div class="text-sm box-border caret-transparent grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12 leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]">
          <!-- Glasgow West End & North West -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Glasgow West End & North West
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Our home patch. We're based in G13, so these neighbourhoods are just minutes away.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Knightswood</li>
              <li>Anniesland</li>
              <li>Scotstoun</li>
              <li>Jordanhill</li>
              <li>Yoker</li>
              <li>Drumchapel</li>
              <li>Garscadden</li>
              <li>Whiteinch</li>
              <li>Broomhill</li>
              <li>Hyndland</li>
              <li>Partick</li>
              <li>Kelvinside</li>
              <li>Kelvindale</li>
              <li>Hillhead</li>
              <li>West End</li>
              <li>Woodlands</li>
              <li>Finnieston</li>
            </ul>
          </div>

          <!-- Glasgow North -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Glasgow North
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Exterior cleaning across Glasgow's northern neighbourhoods.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Maryhill</li>
              <li>Summerston</li>
              <li>North Kelvinside</li>
              <li>Ruchill</li>
              <li>Lambhill</li>
              <li>Possilpark</li>
              <li>Milton</li>
              <li>Springburn</li>
              <li>Balornock</li>
              <li>Robroyston</li>
            </ul>
          </div>

          <!-- Glasgow City Centre & East End -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Glasgow City Centre & East End
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              City-centre properties, tenements, and homes across the East End.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Glasgow City Centre</li>
              <li>Merchant City</li>
              <li>Gorbals</li>
              <li>Dennistoun</li>
              <li>Riddrie</li>
              <li>Bridgeton</li>
              <li>Parkhead</li>
              <li>Carntyne</li>
              <li>Shettleston</li>
              <li>Tollcross</li>
              <li>Mount Vernon</li>
              <li>Carmyle</li>
              <li>Garrowhill</li>
              <li>Baillieston</li>
              <li>Easterhouse</li>
            </ul>
          </div>

          <!-- Glasgow South Side -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Glasgow South Side
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Homes and businesses across Glasgow's South Side.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Govan</li>
              <li>Ibrox</li>
              <li>Craigton</li>
              <li>Cardonald</li>
              <li>Hillington</li>
              <li>Penilee</li>
              <li>Crookston</li>
              <li>Mosspark</li>
              <li>Pollok</li>
              <li>Pollokshields</li>
              <li>Pollokshaws</li>
              <li>Shawlands</li>
              <li>Govanhill</li>
              <li>Battlefield</li>
              <li>Mount Florida</li>
              <li>Cathcart</li>
              <li>Newlands</li>
              <li>King's Park</li>
              <li>Croftfoot</li>
              <li>Castlemilk</li>
              <li>Carmunnock</li>
              <li>Priesthill</li>
              <li>Nitshill</li>
              <li>Darnley</li>
            </ul>
          </div>

          <!-- East Dunbartonshire -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              East Dunbartonshire
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Just north of our base, from Bearsden and Milngavie out to the Campsies.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Bearsden</li>
              <li>Westerton</li>
              <li>Milngavie</li>
              <li>Baldernock</li>
              <li>Bishopbriggs</li>
              <li>Torrance</li>
              <li>Kirkintilloch</li>
              <li>Lenzie</li>
              <li>Lennoxtown</li>
              <li>Milton of Campsie</li>
              <li>Twechar</li>
            </ul>
          </div>

          <!-- West Dunbartonshire -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              West Dunbartonshire
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Along the Clyde from Clydebank to Dumbarton and the Vale of Leven.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Clydebank</li>
              <li>Dalmuir</li>
              <li>Duntocher</li>
              <li>Hardgate</li>
              <li>Faifley</li>
              <li>Old Kilpatrick</li>
              <li>Bowling</li>
              <li>Dumbarton</li>
              <li>Renton</li>
              <li>Bonhill</li>
              <li>Alexandria</li>
              <li>Balloch</li>
            </ul>
          </div>

          <!-- Renfrewshire -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Renfrewshire
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Across the river from our base, from Renfrew and Paisley to the villages beyond.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Renfrew</li>
              <li>Braehead</li>
              <li>Inchinnan</li>
              <li>Erskine</li>
              <li>Bishopton</li>
              <li>Langbank</li>
              <li>Paisley</li>
              <li>Ralston</li>
              <li>Glenburn</li>
              <li>Foxbar</li>
              <li>Elderslie</li>
              <li>Linwood</li>
              <li>Johnstone</li>
              <li>Houston</li>
              <li>Kilbarchan</li>
              <li>Bridge of Weir</li>
              <li>Howwood</li>
              <li>Kilmacolm</li>
            </ul>
          </div>

          <!-- East Renfrewshire -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              East Renfrewshire
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              Homes across East Renfrewshire's suburbs and villages.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Giffnock</li>
              <li>Thornliebank</li>
              <li>Clarkston</li>
              <li>Netherlee</li>
              <li>Williamwood</li>
              <li>Busby</li>
              <li>Newton Mearns</li>
              <li>Waterfoot</li>
              <li>Eaglesham</li>
              <li>Barrhead</li>
              <li>Neilston</li>
              <li>Uplawmoor</li>
            </ul>
          </div>

          <!-- South & North Lanarkshire -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              South & North Lanarkshire
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              The south-east and north-east edges of our 20km service area.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Rutherglen</li>
              <li>Burnside</li>
              <li>Cambuslang</li>
              <li>Blantyre</li>
              <li>East Kilbride</li>
              <li>Uddingston</li>
              <li>Viewpark</li>
              <li>Stepps</li>
              <li>Muirhead</li>
              <li>Chryston</li>
              <li>Moodiesburn</li>
              <li>Gartcosh</li>
              <li>Kilsyth</li>
            </ul>
          </div>

          <!-- Strathblane & Stirlingshire Villages -->
          <div class="bg-white border-2 border-[#17539B]/20 rounded-lg p-6 shadow-md hover:shadow-lg transition-shadow">
            <h3 class="text-[#17539B] text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-3">
              Strathblane & Stirlingshire Villages
            </h3>
            <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words font-figtree mb-4">
              The villages at the northern edge of our area.
            </p>
            <ul class="text-neutral-700 text-sm box-border caret-transparent leading-6 break-words font-figtree list-disc list-inside columns-2 gap-4">
              <li>Strathblane</li>
              <li>Blanefield</li>
              <li>Killearn</li>
              <li>Balfron</li>
            </ul>
          </div>
        </div>

        <!-- Additional Areas -->
        <div class="text-sm box-border caret-transparent bg-cyan-50 rounded-lg p-8 mb-12 leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]">
          <h3 class="text-cyan-600 text-2xl font-bold box-border caret-transparent leading-8 break-words uppercase font-thiccboi mb-4 text-center">
            Exterior Cleaning Within 20km of Glasgow G13
          </h3>
          <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words text-center font-figtree mb-6 md:text-lg md:leading-7">
            Every area above is within 20km of our base in Glasgow G13. Roof cleaning, gutter cleaning, pressure washing, soft washing, driveway and patio cleaning, uPVC cleaning, and conservatory cleaning are available throughout.
          </p>
          <p class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words text-center font-figtree mt-6 md:text-lg md:leading-7">
            Don't see your specific area listed? <a href="/contact" class="text-cyan-600 font-semibold hover:text-cyan-700 underline">Contact us</a> to find out if we can serve your location.
          </p>
        </div>

        <!-- Why Choose Local Service -->
        <div class="text-sm box-border caret-transparent mb-12 leading-[20.3px] break-words md:text-[17px] md:leading-[24.65px]">
          <h2 class="text-neutral-900 text-3xl font-bold box-border caret-transparent leading-[42px] break-words uppercase font-thiccboi mb-6 text-center md:text-4xl md:leading-[50px]">
            Why Choose a Local Service?
          </h2>
          <div class="text-neutral-700 text-base box-border caret-transparent leading-6 break-words space-y-4 font-figtree md:text-lg md:leading-7 max-w-4xl mx-auto">
            <p>
              As a Glasgow-based company, we know the challenges of keeping properties clean in the west of Scotland, from sandstone tenements in the West End to newer homes in the suburbs. Heavy rainfall and damp conditions mean moss, algae, and grime build up quickly, and we have the knowledge and equipment to deal with them.
            </p>
            <p>
              Our local presence means we can respond quickly to your needs, provide personalized service, and understand the local regulations and requirements. We're committed to building long-term relationships with our customers and supporting the local community.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Contact CTA Section -->
    <div class="relative text-sm items-center box-border caret-transparent flex justify-center leading-[20.3px] break-words px-5 py-10 bg-neutral-50 md:text-[17px] md:leading-[24.65px] md:px-5 md:py-16">
      <div class="text-sm box-border caret-transparent grow leading-[20.3px] max-w-[800px] break-words mx-auto md:text-[17px] md:leading-[24.65px]">
        <div id="contact">
          <ContactFormSection client:load />
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

